# Copy this file to `.env` (same folder) and fill in the provider(s) you use.
# Never commit the real .env — it is already covered by .gitignore.

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (has free-tier models; base URL handled via /connect)
# OPENROUTER_API_KEY=sk-or-...

# --- Privacy / safe profile (see docs/13-security-audit.md) ---
# The engine image sets these safe defaults already; uncomment to force/override.
# LETTA_CODE_TELEM=0                     # disable Letta Code telemetry
# DO_NOT_TRACK=1                         # general opt-out (telemetry + install analytics)
# SCARF_ANALYTICS=false                  # disable install-time Scarf analytics
# DISABLE_AUTOUPDATER=1                  # disable the npm self-updater
# LETTA_LOCAL_BACKEND_EXPERIMENTAL=1     # in-process backend: no Letta server/cloud
# LETTA_BASE_URL=http://127.0.0.1:4500   # point the API backend at your own server
