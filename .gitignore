# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
# NOTE: `/build/` is anchored to the repo root on purpose. A bare `build/`
# would also match vendored package output such as `vendor/ink/build`, which
# must stay tracked (see docs/12-vendor-sync.md).
.next/
out/
dist/
/build/

# Env & secrets
.env
.env.local
.env.*.local
!.env.example

# Letta local state (runtime: MemFS, auth, provider keys) - never commit
.letta/
.letta-local/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local dev-tool state (personal AI/IDE preferences - not project code)
.commandcode/

# Misc
coverage/
.nyc_output/
*.tsbuildinfo
