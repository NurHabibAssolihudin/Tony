# Keep line endings deterministic.
#
# Source, config and docs are LF everywhere. Biome (the formatter) expects LF,
# and CI runs on Linux, so forcing LF avoids spurious `bun run check` failures
# on Windows checkouts (core.autocrlf) while keeping diffs stable.
* text=auto eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
docker/** text eol=lf
compose.yaml text eol=lf
.dockerignore text eol=lf

*.ts text eol=lf
*.tsx text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.nix text eol=lf

# Binary assets must never be treated as text.
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.node binary
*.wasm binary
