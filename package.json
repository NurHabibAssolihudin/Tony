{
  "name": "tony",
  "version": "0.1.0",
  "private": true,
  "description": "Tony - a self-hosted personal AI assistant built on the vendored Letta Code engine.",
  "license": "Apache-2.0",
  "scripts": {
    "setup": "bun install --cwd engine",
    "check": "bun run --cwd engine check",
    "typecheck": "bun run --cwd engine typecheck",
    "lint": "bun run --cwd engine lint",
    "fix": "bun run --cwd engine fix",
    "build": "bun run --cwd engine build",
    "dev": "bun run --cwd engine dev",
    "test": "node scripts/tony/run-unit-tests.mjs",
    "test:changed": "node scripts/tony/run-unit-tests.mjs --changed-only"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
